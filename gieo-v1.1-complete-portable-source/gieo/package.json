{
  "name": "gieo",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "GIEO current v1.1 source, with a portable static build and bilingual living philosophy experiences.",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/serve.mjs --dev",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "preview": "node --env-file-if-exists=.env scripts/serve.mjs",
    "check": "node scripts/syntax-check.mjs",
    "test": "node --test scripts/checks.mjs scripts/portable-checks.mjs"
  }
}
